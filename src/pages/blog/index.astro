---
import Base from '../../layouts/Base.astro';
import { posts, coverFor } from '../../data/posts';

const sorted = [...posts].sort((a, b) => +new Date(b.date) - +new Date(a.date));
---

<Base title="Blog" description="IPTV guides, step-by-step setup tutorials, player comparisons, pricing advice, and troubleshooting fixes for Firestick, Smart TV, and Android.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <h1>Guides & troubleshooting</h1>
      <p class="muted lead">
        Setup walkthroughs, device tips, and fixes for common IPTV issues.
      </p>

      <div class="grid posts">
        {
          sorted.map((p) => (
            <a href={`/blog/${p.slug}`} class="card post">
              <span class="post-thumb">
                {coverFor(p.slug) ? (
                  <img src={coverFor(p.slug)} alt={p.title} width="1376" height="768" loading="lazy" />
                ) : (
                  <span class="thumb-fallback">▶</span>
                )}
              </span>
              <span class="post-content">
                <span class="post-date muted">
                  {new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <h2>{p.title}</h2>
                <p class="muted">{p.excerpt}</p>
                <span class="read-more">Read more →</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    max-width: 54ch;
    margin-bottom: 34px;
  }
  .posts {
    grid-template-columns: repeat(3, 1fr);
  }
  .post {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-4px);
    border-color: var(--brand);
  }
  .post-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--surface-2), var(--bg-soft));
    display: grid;
    place-items: center;
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .post:hover .post-thumb img {
    transform: scale(1.06);
  }
  .thumb-fallback {
    font-size: 2.4rem;
    color: var(--brand-text);
    opacity: 0.5;
  }
  .post-content {
    display: block;
    padding: 18px 20px 22px;
  }
  .post-date {
    font-size: 0.8rem;
  }
  .post h2 {
    font-size: 1.12rem;
    margin: 8px 0 8px;
  }
  .post p {
    font-size: 0.9rem;
  }
  .read-more {
    color: var(--brand-text);
    font-weight: 700;
    font-size: 0.9rem;
  }
  @media (max-width: 900px) {
    .posts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
