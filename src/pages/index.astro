---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PricingSpotlight from '../components/PricingSpotlight.astro';
import PaymentsTrust from '../components/PaymentsTrust.astro';
import TrustBar from '../components/TrustBar.astro';
import Stats from '../components/Stats.astro';
import Categories from '../components/Categories.astro';
import Testimonials from '../components/Testimonials.astro';
import { site, features, steps } from '../data/site';
import { homeFaqs } from '../data/faqs';
import { posts, coverFor } from '../data/posts';
import { tiers } from '../data/plans';

const recentPosts = posts.slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Product + Offer schema (real prices → price rich results in Google).
const allPrices = tiers.flatMap((t) => Object.values(t.prices));
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${site.name} — IPTV Subscription`,
  description: site.description,
  image: new URL('/images/hero-devices.jpg', site.url).href,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: Math.min(...allPrices).toFixed(2),
    highPrice: Math.max(...allPrices).toFixed(2),
    offerCount: allPrices.length,
    availability: 'https://schema.org/InStock',
    url: `${site.url}/#pricing`,
  },
};
---

<Base>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Premium IPTV Service</span>
        <h1>Buy an IPTV Subscription Online</h1>
        <p class="lead muted">
          Reliable IPTV for Smart TV, Firestick, Android TV, and mobile. Tens of thousands of
          live channels, a huge movie and series library, fast activation, and support included.
        </p>
        <div class="hero-actions">
          <a href="#pricing" class="btn btn-primary">View Plans</a>
          <a href="#how" class="btn btn-ghost">How it works</a>
        </div>
        <div class="hero-trust">
          <span>⚡ Fast activation</span>
          <span>📺 All devices</span>
          <span>🛟 Support included</span>
        </div>
      </div>

      <div class="hero-card hero-visual">
        <img
          src="/images/hero-devices.jpg"
          alt="Watch IPTV on a Smart TV, smartphone and streaming stick"
          width="1408"
          height="768"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- PRICING -->
  <PricingSpotlight />

  <PaymentsTrust />

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Why choose us</span>
        <h2>Everything you need to start watching</h2>
      </div>
      <div class="grid features">
        {
          features.map((f) => (
            <div class="card feature">
              <span class="feature-icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p class="muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Stats />

  <Categories />

  <!-- HOW IT WORKS -->
  <section class="section how" id="how">
    <div class="container">
      <div class="center">
        <span class="eyebrow">Simple setup</span>
        <h2>Up and running in four steps</h2>
      </div>
      <div class="grid steps">
        {
          steps.map((s) => (
            <div class="card step">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- BLOG PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <div>
          <span class="eyebrow">From the blog</span>
          <h2>Guides & troubleshooting</h2>
        </div>
        <a href="/blog" class="btn btn-ghost">View all guides</a>
      </div>
      <div class="grid posts">
        {
          recentPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="card post">
              <span class="post-thumb">
                {coverFor(p.slug) ? (
                  <img src={coverFor(p.slug)} alt={p.title} width="1376" height="768" loading="lazy" />
                ) : (
                  <span class="thumb-fallback">▶</span>
                )}
              </span>
              <span class="post-content">
                <span class="post-date muted">{new Date(p.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <h3>{p.title}</h3>
                <p class="muted">{p.excerpt}</p>
                <span class="read-more">Read more →</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <div class="container narrow">
      <div class="center">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        {
          homeFaqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="center" style="margin-top: 28px;">
        <a href="/faq" class="btn btn-ghost">See all FAQs →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta">
        <h2>Ready to start watching?</h2>
        <p class="muted">Choose a plan and get activated fast — support is here if you need it.</p>
        <div class="hero-actions center-actions">
          <a href="#pricing" class="btn btn-primary">Order Now</a>
          <a href="/contact" class="btn btn-ghost">Contact support</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 72px 0 40px;
    /* animated aurora glow is provided by .hero::before in animations.css */
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .lead {
    font-size: 1.1rem;
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    margin: 26px 0 20px;
    flex-wrap: wrap;
  }
  .center-actions {
    justify-content: center;
  }
  .hero-trust {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .hero-visual {
    border-radius: var(--radius-lg);
  }
  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.5));
  }
  .hero-stat strong {
    display: block;
    font-size: 1.5rem;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-stat span {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .section-sub {
    max-width: 56ch;
    margin: 8px auto 0;
  }
  .center h2,
  .center .eyebrow {
    margin-bottom: 6px;
  }
  .features {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 40px;
  }
  .feature-icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    box-shadow: 0 8px 22px rgba(63, 109, 255, 0.3);
  }
  .feature:nth-child(3n + 2) .feature-icon {
    background: linear-gradient(135deg, var(--red), var(--red-2));
    box-shadow: 0 8px 22px rgba(208, 39, 60, 0.3);
  }
  .feature:hover .feature-icon {
    animation: bob 0.9s ease-in-out;
  }
  .feature h3 {
    margin: 16px 0 6px;
    font-size: 1.15rem;
  }
  .feature p {
    font-size: 0.92rem;
    margin: 0;
  }
  .plans {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 44px;
    align-items: start;
  }
  .how {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .steps {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .step h3 {
    font-size: 1.1rem;
  }
  .step p {
    font-size: 0.9rem;
    margin: 0;
  }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 34px;
  }
  .posts {
    grid-template-columns: repeat(3, 1fr);
  }
  .post {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-4px);
    border-color: var(--brand);
  }
  .post-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--surface-2), var(--bg-soft));
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .post:hover .post-thumb img {
    transform: scale(1.06);
  }
  .thumb-fallback {
    font-size: 2.4rem;
    color: var(--brand);
    opacity: 0.5;
  }
  .post-content {
    display: block;
    padding: 18px 20px 22px;
  }
  .post-date {
    font-size: 0.8rem;
  }
  .post h3 {
    font-size: 1.12rem;
    margin: 8px 0 8px;
  }
  .post p {
    font-size: 0.9rem;
  }
  .read-more {
    color: var(--brand);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .narrow {
    max-width: 780px;
  }
  .faq-list {
    margin-top: 34px;
    display: grid;
    gap: 12px;
  }
  .faq {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 4px 20px;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 16px 0;
    list-style: none;
    position: relative;
    padding-right: 30px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 0;
    font-size: 1.3rem;
    color: var(--brand);
  }
  .faq[open] summary::after {
    content: '−';
  }
  .faq p {
    padding-bottom: 16px;
    margin: 0;
    font-size: 0.94rem;
  }
  .cta {
    text-align: center;
    background:
      radial-gradient(600px 300px at 50% 0%, rgba(63, 109, 255, 0.16), transparent),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 56px 24px;
  }
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .features,
    .plans,
    .steps,
    .posts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .features,
    .plans,
    .steps,
    .posts {
      grid-template-columns: 1fr;
    }
    .head-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
