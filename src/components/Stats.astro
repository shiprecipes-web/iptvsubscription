---
import { stats } from '../data/site';
---

<section class="stats-band">
  <div class="container stats-inner">
    {
      stats.map((s) => (
        <div class="stat">
          <strong class="count" data-target={s.value} data-suffix={s.suffix}>0</strong>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats-band {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 40px 0;
  }
  .stats-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }
  .stat strong {
    display: block;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat span {
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 620px) {
    .stats-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const format = (n: number) => n.toLocaleString('en-US');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = format(Math.floor(eased * target)) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const counts = document.querySelectorAll<HTMLElement>('.count');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            animate(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    counts.forEach((c) => io.observe(c));
  } else {
    counts.forEach((c) => animate(c));
  }
</script>
