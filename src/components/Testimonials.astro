---
import { testimonials } from '../data/site';

// Distinct avatar gradients so each reviewer reads as a different person.
const grads = [
  'linear-gradient(135deg, #3f6dff, #6d8dff)',
  'linear-gradient(135deg, #d0273c, #ff6b7d)',
  'linear-gradient(135deg, #22d3a6, #3f6dff)',
  'linear-gradient(135deg, #7b5cff, #d0273c)',
];
---

<section class="section testimonials">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Why choose us</span>
      <h2>What our customers value</h2>
      <p class="muted section-sub">A few of the reasons people pick our service for their streaming.</p>
    </div>

    <div class="grid t-grid">
      {
        testimonials.map((t, i) => (
          <figure class="card t-card">
            <span class="quote-mark" aria-hidden="true">“</span>
            <div class="stars" aria-label={`${t.rating} out of 5 stars`}>
              {'★'.repeat(t.rating)}
            </div>
            <blockquote>{t.text}</blockquote>
            <figcaption>
              <span class="avatar" style={`background:${grads[i % grads.length]}`}>
                {t.name.charAt(0)}
              </span>
              <span class="who">
                <strong>{t.name}</strong>
                <em>{t.role}</em>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-sub {
    max-width: 52ch;
    margin: 8px auto 0;
  }
  .t-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
  }
  .t-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .quote-mark {
    position: absolute;
    top: -18px;
    right: 10px;
    font-size: 6rem;
    line-height: 1;
    font-family: Georgia, serif;
    color: var(--brand);
    opacity: 0.1;
    pointer-events: none;
  }
  .stars {
    color: #ffc24b;
    letter-spacing: 2px;
    font-size: 1.05rem;
  }
  blockquote {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    flex: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--border);
  }
  .verified {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    border: 2px solid var(--surface);
  }
  .who strong {
    display: block;
    font-size: 0.92rem;
  }
  .who em {
    font-style: normal;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .t-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .t-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
