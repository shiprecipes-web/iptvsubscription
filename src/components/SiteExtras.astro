---
import { site } from '../data/site';
import { WHATSAPP_PHONE, ORDER_LABEL } from '../data/plans';

const waLink = `https://api.whatsapp.com/send/?${new URLSearchParams({
  phone: WHATSAPP_PHONE,
  text: `${ORDER_LABEL} - Hi, I have a question`,
  type: 'phone_number',
  app_absent: '0',
}).toString()}`;
---

<!-- Sticky mobile order bar -->
<div class="mobile-bar">
  <span>Ready to watch?</span>
  <a href={site.orderUrl} class="btn btn-primary">Order Now</a>
</div>

<!-- Floating WhatsApp button -->
<a
  href={waLink}
  target="_blank"
  rel="noopener"
  class="wa-float"
  aria-label="Chat with us on WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.6 1.8 6.5L3 29l7.2-2.2c1.8 1 3.9 1.6 6 1.6 6.9 0 12.5-5.6 12.5-12.5S22.9 3 16 3zm0 22.7c-1.9 0-3.7-.5-5.2-1.4l-.4-.2-4.3 1.3 1.3-4.2-.3-.4c-1-1.6-1.6-3.5-1.6-5.6 0-5.7 4.6-10.3 10.3-10.3s10.3 4.6 10.3 10.3-4.6 10.5-10.4 10.5zm5.8-7.7c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1c-1.9-.9-3.1-1.7-4.4-3.8-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.6s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.8.4-.3.4-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.4 4.8 2 .8 2.7.9 3.7.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.3-.3-.4-.6-.5z" />
  </svg>
  <span class="wa-pulse"></span>
</a>

<!-- Back to top -->
<button id="toTop" class="to-top" aria-label="Back to top">↑</button>

<!-- Cookie notice -->
<div id="cookie" class="cookie" hidden>
  <p>We use cookies to run this site and improve your experience.</p>
  <button id="cookieOk" class="btn btn-primary">Got it</button>
</div>

<style>
  .mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(10, 18, 48, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
    font-weight: 700;
  }
  .mobile-bar .btn {
    padding: 10px 18px;
  }
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 56;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #25d366, #128c7e);
    box-shadow: 0 10px 30px rgba(18, 140, 126, 0.5);
    transition: transform 0.18s ease;
  }
  .wa-float:hover {
    transform: scale(1.08);
  }
  .wa-float svg {
    width: 32px;
    height: 32px;
    fill: #fff;
  }
  .wa-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: waPulse 2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes waPulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .to-top {
    position: fixed;
    right: 27px;
    bottom: 90px;
    z-index: 55;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.15s ease;
  }
  .to-top.show {
    opacity: 1;
    pointer-events: auto;
  }
  .to-top:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 70;
    max-width: 340px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .cookie p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cookie .btn {
    padding: 8px 16px;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .mobile-bar {
      display: flex;
    }
    /* lift floating controls above the sticky order bar */
    .wa-float {
      bottom: 80px;
      right: 16px;
      width: 52px;
      height: 52px;
    }
    .wa-float svg {
      width: 28px;
      height: 28px;
    }
    .to-top {
      bottom: 142px;
      right: 20px;
    }
    .cookie {
      bottom: 80px;
      left: 12px;
      right: 80px;
      max-width: none;
    }
  }
</style>

<script>
  // Back to top
  const toTop = document.getElementById('toTop');
  const onScroll = () => {
    if (window.scrollY > 500) toTop?.classList.add('show');
    else toTop?.classList.remove('show');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // Cookie notice
  const cookie = document.getElementById('cookie');
  try {
    if (!localStorage.getItem('cookie-ok')) cookie?.removeAttribute('hidden');
  } catch {
    cookie?.removeAttribute('hidden');
  }
  document.getElementById('cookieOk')?.addEventListener('click', () => {
    try {
      localStorage.setItem('cookie-ok', '1');
    } catch {}
    cookie?.setAttribute('hidden', '');
  });
</script>
